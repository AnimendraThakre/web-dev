# =============================================================================
# MFA Auth — Environment Variables
# Copy to .env for local dev. On Vercel: Settings → Environment Variables
# NEVER commit .env to git
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (production) — free M0 tier: https://www.mongodb.com/atlas
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mfa_auth?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mfa_auth

# Field encryption for totpSecret (AES-256-GCM via Node crypto)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# JWT session secrets (min 16 chars; use long random strings in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_MFA_SECRET=your-mfa-pending-secret-change-in-production

# Cookie max age in ms (default 24h)
COOKIE_MAX_AGE_MS=86400000

# Google Authenticator app label
TOTP_APP_NAME=MFA Auth

# CORS — comma-separated allowed origins (production)
CORS_ORIGIN=

# SMTP — email OTP at registration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

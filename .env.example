# Server
PORT=3000
NODE_ENV=development

# MongoDB (leave empty or invalid to use in-memory store)
MONGODB_URI=mongodb://127.0.0.1:27017/mfa_auth

# JWT secrets (use long random strings in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_MFA_SECRET=your-mfa-pending-secret-change-in-production

# Session cookie
COOKIE_MAX_AGE_MS=86400000

# --- Email (required for real OTP delivery) ---
# Option A: Gmail (recommended for testing)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Fill in SMTP_USER and SMTP_PASS below (use the App Password, NOT your Gmail password)

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="MFA Auth <your-email@gmail.com>"

# Option B: Custom SMTP (SendGrid, Brevo, etc.)
# Leave SMTP_SERVICE empty and set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS instead.

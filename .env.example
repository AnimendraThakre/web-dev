# =============================================================================
# MFA Auth — Environment Variables
# Copy to .env for local dev. On Vercel: Settings → Environment Variables
# NEVER commit .env to git
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Neon PostgreSQL (Vercel Storage auto-adds POSTGRES_URL)
# Pull from Vercel: vercel env pull .env.local
# Or copy from Neon dashboard → Connection string (pooled)
POSTGRES_URL=

# Legacy — no longer used (app now uses Neon Postgres)
# MONGODB_URI=

# Field encryption for totpSecret (AES-256-GCM via Node crypto)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# JWT session secrets (min 16 chars; use long random strings in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_MFA_SECRET=your-mfa-pending-secret-change-in-production

# Cookie max age in ms (default 24h)
COOKIE_MAX_AGE_MS=86400000

# Google Authenticator app label
TOTP_APP_NAME=MFA Auth

# CORS — comma-separated allowed origins (production)
CORS_ORIGIN=

# SMTP — email OTP at registration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default admin (optional — created on server start if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpass123
ADMIN_FULL_NAME=System Admin
